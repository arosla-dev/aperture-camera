Refract
{
$model 1
$bluramount 1
$scale "[1 1]"
$basetexture "_rt_poweroftwofb" // fixes overbright with mat_hdr_level 3
$normalmap "HUD\camera_viewfinder_normal_ul"
$bumpframe 0
$translucent 1
$ignorez 1
$nofog 1
$refracttinttexture "HUD\camera_viewfinder_ul"
$forcerefract 1
$refractamount .2

$scaleamount "[1 1]"
}
