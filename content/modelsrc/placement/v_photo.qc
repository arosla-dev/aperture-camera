$poseparameter "photo_scale" 0 1 loop 0

$animation "v_photo_in_corrective_animation" "v_photo_anims\v_photo_in_corrective_animation.smd" {
}

$animation "v_photo_neutral_full_corrective_animation" "v_photo_anims\v_photo_neutral_full_corrective_animation.smd" {
}

$animation "v_photo_out_corrective_animation" "v_photo_anims\v_photo_out_corrective_animation.smd" {
}

$animation "v_photo_neutral" "v_photo_anims\v_photo_neutral.smd" {
	fps 30
}

$animation "v_photo_neutral_full" "v_photo_anims\v_photo_neutral_full.smd" {
	fps 30
	// Crowbar writes this subtract option to prevent jigglebone and poseparameter problems when delta sequences are recompiled.
	subtract "v_photo_neutral_full_corrective_animation" 0
}

$animation "v_photo_in" "v_photo_anims\v_photo_in.smd" {
	fps 30
	// Crowbar writes this subtract option to prevent jigglebone and poseparameter problems when delta sequences are recompiled.
	subtract "v_photo_in_corrective_animation" 0
}

$animation "v_photo_out" "v_photo_anims\v_photo_out.smd" {
	fps 30
	// Crowbar writes this subtract option to prevent jigglebone and poseparameter problems when delta sequences are recompiled.
	subtract "v_photo_out_corrective_animation" 0
}

$sequence "ref" {
	"v_photo_anims\ref.smd"
	fadein 0.2
	fadeout 0.2
	fps 30
}

$sequence "v_photo_raise" {
	"v_photo_anims\v_photo_raise.smd"
	activity "ACT_VM_DRAW" 1
	fadein 0.2
	fadeout 0.2
	snap
	fps 30
}

$sequence "v_photo_scale" {
	"v_photo_in"
	"v_photo_neutral_full"
	"v_photo_out"
	blend "photo_scale" 0 1
	blendwidth 3
	delta
	fadein 0.2
	fadeout 0.2
	hidden
}

$sequence "v_photo_place" {
	"v_photo_anims\v_photo_place.smd"
	activity "ACT_VM_IDLE" 1
	fadein 0.2
	fadeout 0.2
	addlayer "v_photo_scale"
	fps 30
}

$sequence "v_photo_idle" {
	"v_photo_anims\v_photo_idle.smd"
	activity "ACT_VM_IDLE_LOWERED" 1
	fadein 0.2
	fadeout 0.2
	fps 30
}
